<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.billiard.presentation.splash.SplashFragment"
        android:label="SplashFragment" >
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.billiard.presentation.auth.LoginFragment"
        android:label="LoginFragment" >
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.billiard.presentation.home.homscreen.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_banDetailFragment"
            app:destination="@id/banDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/administraitorFragment"
        android:name="com.example.billiard.presentation.administrator.admin.AdministraitorFragment"
        android:label="fragment_administraitor"
        tools:layout="@layout/fragment_administraitor" >
        <action
            android:id="@+id/action_administraitorFragment_to_tableManageFragment"
            app:destination="@id/tableManageFragment" />
        <action
            android:id="@+id/action_administraitorFragment_to_timeSlotManagementFragmentFragment"
            app:destination="@id/timeSlotManagementFragmentFragment" />
        <action
            android:id="@+id/action_administraitorFragment_to_voucherFragment"
            app:destination="@id/voucherFragment" />
        <action
            android:id="@+id/action_administraitorFragment_to_employeeManagementFragment"
            app:destination="@id/employeeManagementFragment" />
        <action
            android:id="@+id/action_administraitorFragment_to_inventoryManagementFragment"
            app:destination="@id/inventoryManagementFragment" />
        <action
            android:id="@+id/action_administraitorFragment_to_bankFragment"
            app:destination="@id/bankFragment" />
    </fragment>
    <fragment
        android:id="@+id/stasticsFragment"
        android:name="com.example.billiard.presentation.stastics.StasticsFragment"
        android:label="fragment_stastics"
        tools:layout="@layout/fragment_stastics" >
        <action
            android:id="@+id/action_stasticsFragment_to_invoiceFragment"
            app:destination="@id/invoiceFragment" />
        <action
            android:id="@+id/action_stasticsFragment_to_itemStatisticsFragment"
            app:destination="@id/itemStatisticsFragment" />
    </fragment>
    <fragment
        android:id="@+id/tableManageFragment"
        android:name="com.example.billiard.presentation.administrator.table.TableManagementFragment"
        android:label="TableManageFragment" />
    <fragment
        android:id="@+id/banDetailFragment"
        android:name="com.example.billiard.presentation.home.openingtable.BanDetailFragment"
        android:label="BanDetailFragment" >
        <action
            android:id="@+id/action_banDetailFragment_to_orderServiceFragment"
            app:destination="@id/orderServiceFragment" />
        <action
            android:id="@+id/action_banDetailFragment_to_paymentFragment"
            app:destination="@id/paymentFragment" />
        <argument
            android:name="INVOICE_ID"
            app:argType="integer" />
    </fragment>
    <fragment
        android:id="@+id/orderServiceFragment"
        android:name="com.example.billiard.presentation.home.orderservice.OrderServiceFragment"
        android:label="OrderServiceFragment" >
        <argument
            android:name="INVOICE_ID"
            app:argType="integer" />
    </fragment>
    <fragment
        android:id="@+id/timeSlotManagementFragmentFragment"
        android:name="com.example.billiard.presentation.administrator.time.TimeSlotManagementFragmentFragment"
        android:label="TimeSlotManagementFragmentFragment" >
        <action
            android:id="@+id/action_timeSlotManagementFragmentFragment_to_timeSlotDetailFragment"
            app:destination="@id/timeSlotDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/timeSlotDetailFragment"
        android:name="com.example.billiard.presentation.administrator.time.detail.TimeSlotDetailFragment"
        android:label="TimeSlotDetailFragment" >
        <argument
            android:name="TABLE_TYPE"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/paymentFragment"
        android:name="com.example.billiard.presentation.home.payment.PaymentFragment"
        android:label="PaymentFragment" >
        <action
            android:id="@+id/action_paymentFragment_to_invoicePaymentFragment"
            app:destination="@id/invoicePaymentFragment" />
    </fragment>
    <fragment
        android:id="@+id/invoicePaymentFragment"
        android:name="com.example.billiard.presentation.home.payment.invoice.InvoicePaymentFragment"
        android:label="InvoicePaymentFragment" >
        <argument
            android:name="INVOICE_JSON"
            app:argType="string" />
        <argument
            android:name="FINAL_TOTAL"
            app:argType="float" />
        <argument
            android:name="VOUCHER_ID"
            app:argType="long" />
        <argument
            android:name="BANK_ID"
            app:argType="integer" />
    </fragment>
    <fragment
        android:id="@+id/voucherFragment"
        android:name="com.example.billiard.presentation.administrator.voucher.VoucherFragment"
        android:label="fragment_voucher"
        tools:layout="@layout/fragment_voucher" >
        <action
            android:id="@+id/action_voucherFragment_to_createVoucherFragment"
            app:destination="@id/createVoucherFragment" />
    </fragment>
    <fragment
        android:id="@+id/createVoucherFragment"
        android:name="com.example.billiard.presentation.administrator.voucher.createvoucher.CreateVoucherFragment"
        android:label="CreateVoucherFragment" />
    <fragment
        android:id="@+id/employeeManagementFragment"
        android:name="com.example.billiard.presentation.administrator.employee.EmployeeManagementFragment"
        android:label="EmployeeManagementFragment" />
    <fragment
        android:id="@+id/inventoryManagementFragment"
        android:name="com.example.billiard.presentation.administrator.inventory.InventoryManagementFragment"
        android:label="InventoryManagementFragment" >
        <action
            android:id="@+id/action_inventoryManagementFragment_to_createReceiptFragment"
            app:destination="@id/createReceiptFragment" />
        <action
            android:id="@+id/action_inventoryManagementFragment_to_receiptDetailFragment"
            app:destination="@id/receiptDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/createReceiptFragment"
        android:name="com.example.billiard.presentation.administrator.inventory.receipt.CreateReceiptFragment"
        android:label="CreateReceiptFragment" >
        <action
            android:id="@+id/action_createReceiptFragment_to_addExistingProductFragment"
            app:destination="@id/addExistingProductFragment" />
    </fragment>
    <fragment
        android:id="@+id/addExistingProductFragment"
        android:name="com.example.billiard.presentation.administrator.inventory.addiavailableitem.AddExistingProductFragment"
        android:label="AddExistingProductFragment" >
        <action
            android:id="@+id/action_addExistingProductFragment_to_createNewProductFragment"
            app:destination="@id/createNewProductFragment" />
    </fragment>
    <fragment
        android:id="@+id/createNewProductFragment"
        android:name="com.example.billiard.presentation.administrator.inventory.createnewproduct.CreateNewProductFragment"
        android:label="CreateNewProductFragment" >
        <action
            android:id="@+id/action_createNewProductFragment_to_createReceiptFragment"
            app:destination="@id/createReceiptFragment" />
    </fragment>
    <fragment
        android:id="@+id/bankFragment"
        android:name="com.example.billiard.presentation.administrator.bank.BankFragment"
        android:label="BankFragment" />
    <fragment
        android:id="@+id/receiptDetailFragment"
        android:name="com.example.billiard.presentation.administrator.inventory.receipt.ReceiptDetailFragment"
        android:label="ReceiptDetailFragment" />
    <fragment
        android:id="@+id/invoiceFragment"
        android:name="com.example.billiard.presentation.stastics.invoice.InvoiceFragment"
        android:label="InvoiceFragment" >
        <action
            android:id="@+id/action_invoiceFragment_to_invoiceDetailFragment"
            app:destination="@id/invoiceDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/invoiceDetailFragment"
        android:name="com.example.billiard.presentation.stastics.invoice.InvoiceDetailFragment"
        android:label="InvoiceDetailFragment" >
        <argument
            android:name="INVOICE_ID"
            app:argType="integer" />
    </fragment>
    <fragment
        android:id="@+id/itemStatisticsFragment"
        android:name="com.example.billiard.presentation.stastics.ItemStatisticsFragment"
        android:label="ItemStatisticsFragment" />
</navigation>